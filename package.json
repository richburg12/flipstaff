{
  "name": "flickfight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "workspaces": ["sim", "server", "client"],
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --host client",
    "build": "npm run build:client && npm run typecheck",
    "build:client": "vite build client",
    "typecheck": "tsc -p sim/tsconfig.json && tsc -p server/tsconfig.json && tsc -p client/tsconfig.json",
    "start": "tsx server/src/index.ts",
    "test": "tsx sim/test/fuzz.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
